{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pele-mele-vinyls",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": true,
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "5481bdd2b5d845d4992a5123817ea5e5",
			"preview_id": "5481bdd2b5d845d4992a5123817ea5e5"
		}
	],
	"triggers": {
		"crons": [
			"0 */3 * * *"
		]
	},
	"vars": {
		"WEBHOOK_ID": "1528057421891895449"
	},
}
